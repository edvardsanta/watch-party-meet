CONFIG={{ jitsi_config_dir }}
{% if enable_caddy_tls | default(false) | bool %}
HTTP_PORT=127.0.0.1:8008
HTTPS_PORT=127.0.0.1:8444
{% else %}
HTTP_PORT=80
HTTPS_PORT=443
{% endif %}
TZ={{ timezone }}
PUBLIC_URL={{ public_url }}

JITSI_IMAGE_REPO={{ jitsi_image_repo }}
JITSI_IMAGE_VERSION={{ jitsi_image_version }}
RESTART_POLICY=unless-stopped

ENABLE_LETSENCRYPT={{ '1' if enable_letsencrypt else '0' }}
LETSENCRYPT_DOMAIN={{ letsencrypt_domain }}
LETSENCRYPT_EMAIL={{ letsencrypt_email }}
LETSENCRYPT_USE_STAGING={{ '1' if letsencrypt_use_staging else '0' }}
LETSENCRYPT_ACME_SERVER=letsencrypt
DISABLE_HTTPS={{ '1' if enable_caddy_tls | default(false) | bool else '0' }}
ENABLE_HTTP_REDIRECT={{ '0' if enable_caddy_tls | default(false) | bool else '1' }}
ENABLE_HSTS=1
DISABLE_DEEP_LINKING=true

JVB_ADVERTISE_IPS={{ jvb_advertise_ips }}
JVB_PORT=10000
ENABLE_P2P={{ '1' if enable_p2p else '0' }}
ENABLE_XMPP_WEBSOCKET=1
ENABLE_COLIBRI_WEBSOCKET=1

XMPP_MUC_MODULES=muc_default_password
WATCHPARTY_ROOM_PASSWORD={{ watchparty_room_password }}
WATCHPARTY_APP_NAME={{ watchparty_app_name }}

CODEC_ORDER_JVB=["VP8","H264","VP9"]
CODEC_ORDER_JVB_MOBILE=["VP8","H264","VP9"]
CODEC_ORDER_P2P=["VP8","H264","VP9"]
CODEC_ORDER_P2P_MOBILE=["VP8","H264","VP9"]
VIDEOQUALITY_PREFERRED_CODEC=VP8
P2P_PREFERRED_CODEC=VP8
ENABLE_CODEC_AV1=0
ENABLE_CODEC_VP8=1
ENABLE_CODEC_H264=1

ENABLE_AUTH=0
ENABLE_GUESTS=1
AUTH_TYPE=internal

JICOFO_AUTH_PASSWORD={{ jicofo_auth_password }}
JVB_AUTH_PASSWORD={{ jvb_auth_password }}
JIGASI_XMPP_PASSWORD={{ jigasi_xmpp_password }}
JIGASI_TRANSCRIBER_PASSWORD={{ jigasi_transcriber_password }}
JIBRI_RECORDER_PASSWORD={{ jibri_recorder_password }}
JIBRI_XMPP_PASSWORD={{ jibri_xmpp_password }}
