#!/usr/bin/with-contenv bash
#
# The upstream 10-config script only reads /config/custom-config.js and
# /config/custom-interface_config.js (files meant to be hand-authored in the
# persistent volume) - it has no idea /defaults/watch-config.js exists.
# Regenerate both from our own defaults/env on every boot so the overrides
# always reach the rendered config.js/interface_config.js, both locally and
# in production, without depending on manual setup.
if [[ -f "/defaults/watch-config.js" ]]; then
    cp /defaults/watch-config.js /config/custom-config.js
fi

if [[ -n "$WATCHPARTY_APP_NAME" ]]; then
    cat > /config/custom-interface_config.js <<EOF
interfaceConfig.APP_NAME = '${WATCHPARTY_APP_NAME}';
interfaceConfig.PROVIDER_NAME = '${WATCHPARTY_APP_NAME}';
EOF

    # title.html is baked into the image at build time, so the og:/itemprop
    # tags still say "Jitsi Meet" unless we rewrite it here at boot.
    # The name lands in HTML text and double-quoted attributes, so escape it.
    APP_NAME_HTML="$(printf '%s' "$WATCHPARTY_APP_NAME" \
        | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' -e 's/"/\&quot;/g')"

    cat > /usr/share/jitsi-meet/title.html <<EOF
<title>${APP_NAME_HTML}</title>
<meta property="og:title" content="${APP_NAME_HTML}"/>
<meta property="og:image" content="images/jitsilogo.png?v=1"/>
<meta property="og:description" content="Join a video conference on ${APP_NAME_HTML}"/>
<meta description="Join a video conference on ${APP_NAME_HTML}"/>
<meta itemprop="name" content="${APP_NAME_HTML}"/>
<meta itemprop="description" content="Join a video conference on ${APP_NAME_HTML}"/>
<meta itemprop="image" content="images/jitsilogo.png?v=1"/>
<link rel="icon" href="images/favicon.svg?v=1">
EOF
fi
